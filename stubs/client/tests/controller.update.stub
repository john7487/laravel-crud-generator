<?php

declare(strict_types=1);

use App\Contracts\{{ model }}\{{ model }}ClientContract;
use App\DTOs\{{ model }}\Data{{ model }}DTO;

it('can update a product', function (): void {
    ${{ variable }} = new Data{{ model }}DTO(
        id: '1',
        name: 'Updated {{ model }}',
        sku: 'PRD-001',
        description: 'Updated description',
        price: '250000.00',
        stock: 150,
        weight: '2.00',
        is_active: true,
    );

    $payload = [
        'name' => 'Updated {{ model }}',
        'sku' => 'PRD-001',
        'description' => 'Updated description',
        'price' => 250000,
        'stock' => 150,
        'weight' => 2,
        'is_active' => true,
    ];

    $this->mock({{ model }}ClientContract::class, function ($mock) use (${{ variable }}, $payload): void {
        $mock
            ->shouldReceive('update')
            ->once()
            ->with($payload, '1')
            ->andReturn(${{ variable }});
    });

    $response = $this->put(
        '/api/v1/{{ table }}/1',
        $payload,
    );

    $response
        ->assertSuccessful()
        ->assertJsonStructure([
            'data' => [
                'type',
                'id',
                'attributes',
            ],
        ])
        ->assertJsonPath('data.id', '1')
        ->assertJsonPath('data.attributes.name', 'Updated {{ model }}')
        ->assertJsonPath('data.attributes.sku', 'PRD-001')
        ->assertJsonPath('data.attributes.stock', 150);
});
