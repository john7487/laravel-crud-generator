<?php

declare(strict_types=1);

use App\Contracts\{{ model }}\{{ model }}ClientContract;
use App\DTOs\{{ model }}\Data{{ model }}DTO;

it('can show a {{ model }}', function (): void {

    ${{ variable }} = new Data{{ model }}DTO(
        id: '1',
        name: '{{ model }} One',
        sku: 'PRD-001',
        description: 'Description One',
        price: '10000.00',
        stock: 10,
        weight: '1.25',
        is_active: true,
    );

    $this->mock({{ model }}ClientContract::class, function ($mock) use (${{ variable }}): void {
        $mock
            ->shouldReceive('show')
            ->once()
            ->with('1')
            ->andReturn(${{ variable }});
    });

    $response = $this->get('/api/v1/{{ table }}/1');

    $response
        ->assertSuccessful()
        ->assertJsonStructure([
            'data' => [
                'type',
                'id',
                'attributes',
            ],
        ])
        ->assertJsonPath('data.id', '1')
        ->assertJsonPath('data.attributes.name', '{{ model }} One')
        ->assertJsonPath('data.attributes.sku', 'PRD-001');
});
