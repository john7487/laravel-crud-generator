<?php

declare(strict_types=1);

use App\Contracts\{{ model }}\{{ model }}ClientContract;
use GuzzleHttp\Psr7\Response as PsrResponse;
use Illuminate\Http\Client\Response;

it('can export {{ table }} with content disposition', function (): void {
    $clientResponse = new Response(
        new PsrResponse(
            200,
            [
                'Content-Type' => 'text/csv',
                'Content-Disposition' => 'attachment; filename="{{ table }}.csv"',
            ],
            'id;name;sku',
        ),
    );

    $this->mock(
        {{ model }}ClientContract::class,
        function ($mock) use ($clientResponse): void {
            $mock
                ->shouldReceive('export')
                ->once()
                ->andReturn($clientResponse);
        },
    );

    $response = $this->get('/api/v1/{{ table }}/export');

    $response
        ->assertOk()
        ->assertHeader(
            'Content-Type',
            'text/csv; charset=utf-8',
        )
        ->assertHeader(
            'Content-Disposition',
            'attachment; filename="{{ table }}.csv"',
        )
        ->assertStreamedContent('id;name;sku');
});

it('can export {{ table }} without content disposition', function (): void {
    $clientResponse = new Response(
        new PsrResponse(
            200,
            [
                'Content-Type' => 'text/csv',
            ],
            'id;name;sku',
        ),
    );

    $this->mock(
        {{ model }}ClientContract::class,
        function ($mock) use ($clientResponse): void {
            $mock
                ->shouldReceive('export')
                ->once()
                ->andReturn($clientResponse);
        },
    );

    $response = $this->get('/api/v1/{{ table }}/export');

    $response
        ->assertOk()
        ->assertHeader(
            'Content-Type',
            'text/csv; charset=utf-8',
        )
        ->assertHeaderMissing('Content-Disposition')
        ->assertStreamedContent('id;name;sku');
});
