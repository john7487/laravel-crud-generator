<?php

declare(strict_types=1);

use App\Contracts\{{ model }}\{{ model }}ClientContract;
use App\DTOs\{{ model }}\Data{{ model }}DTO;

it('can list {{ table }}', function (): void {
    ${{ table }} = [
        new Data{{ model }}DTO(
            id: '1',
            name: '{{ model }} One',
            sku: 'PRD-001',
            description: 'Description One',
            price: '10000',
            stock: 10,
            weight: '1.25',
            is_active: true,
        ),
        new Data{{ model }}DTO(
            id: '2',
            name: '{{ model }} Two',
            sku: 'PRD-002',
            description: 'Description Two',
            price: '20000',
            stock: 20,
            weight: '2.50',
            is_active: true,
        ),
        new Data{{ model }}DTO(
            id: '3',
            name: '{{ model }} Three',
            sku: 'PRD-003',
            description: 'Description Three',
            price: '30000',
            stock: 30,
            weight: '3.75',
            is_active: false,
        ),
    ];

    $this->mock({{ model }}ClientContract::class, function ($mock) use (${{ table }}): void {
        $mock
            ->shouldReceive('index')
            ->once()
            ->andReturn(${{ table }});
    });

    $response = $this->get('/api/v1/{{ table }}');

    $response
        ->assertSuccessful()
        ->assertJsonStructure([
            'data' => [
                '*' => [
                    'type',
                    'id',
                    'attributes' => [
                        'name',
                        'sku',
                        'description',
                        'price',
                        'stock',
                        'weight',
                        'is_active',
                    ],
                ],
            ],
        ]);

    expect($response->json('data'))->toHaveCount(3);
});

it('returns empty data when there are no {{ table }}', function (): void {
    $this->mock({{ model }}ClientContract::class, function ($mock): void {
        $mock
            ->shouldReceive('index')
            ->once()
            ->andReturn([]);
    });

    $response = $this->get('/api/v1/{{ table }}');

    $response
        ->assertSuccessful()
        ->assertJsonStructure([
            'data',
        ]);

    expect($response->json('data'))->toBeArray()->toBeEmpty();
});
