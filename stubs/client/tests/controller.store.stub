<?php

declare(strict_types=1);

use App\Contracts\{{ model }}\{{ model }}ClientContract;
use App\DTOs\{{ model }}\Data{{ model }}DTO;

it('can store a {{ variable }}', function (): void {
    $payload = [
        'name' => 'Test {{ model }}',
        'sku' => 'PRD-001',
        'description' => '{{ model }} description',
        'price' => 150000.50,
        'stock' => 100,
        'weight' => 1.25,
        'is_active' => true,
    ];

    ${{ variable }} = new Data{{ model }}DTO(
        id: '1',
        name: 'Test {{ model }}',
        sku: 'PRD-001',
        description: '{{ model }} description',
        price: '150000.50',
        stock: 100,
        weight: '1.25',
        is_active: true,
    );

    $this->mock({{ model }}ClientContract::class, function ($mock) use ($payload, ${{ variable }}): void {
        $mock
            ->shouldReceive('store')
            ->once()
            ->with($payload)
            ->andReturn(${{ variable }});
    });

    $response = $this->post('/api/v1/{{ table }}', $payload);

    $response
        ->assertSuccessful()
        ->assertJsonStructure([
            'data' => [
                'type',
                'id',
                'attributes' => [
                    'name',
                    'sku',
                    'description',
                    'price',
                    'stock',
                    'weight',
                    'is_active',
                ],
            ],
        ])
        ->assertJsonPath('data.id', '1')
        ->assertJsonPath('data.attributes.name', 'Test {{ model }}')
        ->assertJsonPath('data.attributes.sku', 'PRD-001')
        ->assertJsonPath('data.attributes.stock', 100);
});

it('requires required fields when storing a {{ variable }}', function (): void {
    $response = $this->post('/api/v1/{{ table }}', []);

    $response->assertUnprocessable();

    $response
        ->assertUnprocessable()
        ->assertJsonCount(5, 'errors')
        ->assertJsonPath('errors.0.source.pointer', '/data/attributes/name')
        ->assertJsonPath('errors.1.source.pointer', '/data/attributes/sku')
        ->assertJsonPath('errors.2.source.pointer', '/data/attributes/price')
        ->assertJsonPath('errors.3.source.pointer', '/data/attributes/stock')
        ->assertJsonPath('errors.4.source.pointer', '/data/attributes/is_active');

});
