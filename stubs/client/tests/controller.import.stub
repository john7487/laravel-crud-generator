<?php

declare(strict_types=1);

use App\Contracts\{{ model }}\{{ model }}ClientContract;
use Illuminate\Http\UploadedFile;

it('can import {{ table }}', function (): void {
    $this->mock({{ model }}ClientContract::class, function ($mock): void {
        $mock
            ->shouldReceive('import')
            ->once()
            ->andReturn(10);
    });

    $file = UploadedFile::fake()->create(
        '{{ table }}.csv',
        10,
        'text/csv',
    );

    $response = $this->post('/api/v1/{{ table }}/import', [
        'file' => $file,
    ]);

    $response
        ->assertOk()
        ->assertJsonPath('meta.inserted', 10);
});
