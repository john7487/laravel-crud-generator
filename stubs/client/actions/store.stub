<?php

declare(strict_types=1);

namespace App\Actions\{{ model }};

use App\Contracts\{{ model }}\{{ model }}ClientContract;
use App\DTOs\{{ model }}\Data{{ model }}DTO;
use App\DTOs\{{ model }}\{{ crud }}{{ model }}DTO;

final readonly class {{ crud }}{{ model }}Action
{
    public function __construct(
        private {{ model }}ClientContract $client,
    ) {}

    /**
     * @return array{{{ variable }}: Data{{ model }}DTO}
     */
    public function execute({{ crud }}{{ model }}DTO $data): array
    {

        ${{ variable }} = $this->client->store($data->attributes);

        return [
            '{{ variable }}' => ${{ variable }},
        ];
    }
}
