<?php

declare(strict_types=1);

namespace App\Actions\{{ model }};

use App\Contracts\{{ model }}\{{ model }}ClientContract;
use Symfony\Component\HttpFoundation\StreamedResponse;

final readonly class Export{{ model }}Action
{
    public function __construct(
        private {{ model }}ClientContract $client,
    ) {}

    public function execute(): StreamedResponse
    {
        $response = $this->client->export();

        $headers = [
            'Content-Type' => $response->header('Content-Type'),
        ];

        if ($response->header('Content-Disposition')) {
            $headers['Content-Disposition'] = $response->header(
                'Content-Disposition',
            );
        }

        return response()->stream(
            function () use ($response): void {
                echo $response->body();
            },
            $response->status(),
            $headers,
        );
    }
}
