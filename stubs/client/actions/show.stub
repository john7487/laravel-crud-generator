use App\DTOs\{{ model }}\Data{{ model }}DTO;

final readonly class {{ crud }}{{ model }}Action
{
    public function __construct(
        private {{ model }}ClientContract $client,
    ) {}

    /**
     * @return array{{{ variable }}: Data{{ model }}DTO}
     */
