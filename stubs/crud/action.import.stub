<?php

declare(strict_types=1);

namespace App\Actions\{{ model }};

use App\DTOs\{{ model }}\{{ crud }}{{ model }}DTO;
use App\Models\{{ model }};
use Illuminate\Support\Facades\DB;


final class {{ crud }}{{ model }}Action
{
    /**
     * Create a new class instance.
     */
    public function __construct()
    {
        //
    }

    public function execute({{ crud }}{{ model }}DTO $data): array
    {

        $rows = $this->readCsv($data);

        DB::transaction(function () use ($rows): void {
            {{ model }}::query()->delete();
            {{ model }}::query()->insert($rows);
        });

        return [
            'inserted' => count($rows),
        ];
    }






   private function readCsv(
        ImportProvinceDTO $data
    ): array {
        $handle = fopen($data->file->getRealPath(),'r');

        if ($handle === false) {
            throw new \RuntimeException(
                'Unable to read CSV.'
            );
        }

        $header = fgetcsv($handle,0,';');

        if ($header === false) {
            throw new \RuntimeException('CSV header not found.');
        }


        $header = array_map(
            fn (string $value): string => $this->removeBom($value),
            $header,
        );


        if ($header !== ['id', 'name']) {
            throw new \RuntimeException(
                'Invalid CSV header.'
            );
        }

        $rows = [];

        while (($row = fgetcsv($handle,0,';')) !== false) {
            $rows[] = [
                'id' => $row[0],
                'name' => $row[1],
            ];
        }

        fclose($handle);

        return $rows;
    }



    private function removeBom(string $value): string
    {
        return preg_replace('/^\xEF\xBB\xBF/', '', $value) ?? $value;
    }




}
