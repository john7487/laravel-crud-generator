<?php

declare(strict_types=1);

use App\Models\User;
use App\Models\{{ model }};
use Laravel\Sanctum\Sanctum;

beforeEach(function (): void {
    $this->user = User::factory()->create();
    $this->endpoint = '/api/{{ route_path }}/{{ table }}';
});

it('can show a {{ variable }}', function (): void {
    ${{ variable }} = {{ model }}::factory()->create([
        'name' => 'Test {{ model }}',
        'sku' => 'PRD-001',
    ]);

    Sanctum::actingAs($this->user);

    $response = $this->get("{$this->endpoint}/{${{ variable }}->id}");

    $response
        ->assertSuccessful()
        ->assertJsonStructure([
            'data' => [
                'type',
                'id',
                'attributes',
            ],
        ]);

    expect($response->json('data.id'))
        ->toBe((string) ${{ variable }}->id);

    expect($response->json('data.attributes.name'))
        ->toBe('Test {{ model }}');

    expect($response->json('data.attributes.sku'))
        ->toBe('PRD-001');
});

it('returns not found when {{ variable }} does not exist', function (): void {

    Sanctum::actingAs($this->user);

    $response = $this->get('{$this->endpoint}/999999');

    $response->assertNotFound();
});
