<?php

declare(strict_types=1);

use App\Models\User;
use App\Models\{{ model }};
use Laravel\Sanctum\Sanctum;

beforeEach(function (): void {
    $this->user = User::factory()->create();
    $this->endpoint = '/api/{{ route_path }}/{{ table }}';
});

it('can update a {{ variable }}', function (): void {
    ${{ variable }} = {{ model }}::factory()->create([
        'name' => 'Old {{ model }}',
        'sku' => 'PRD-001',
        'price' => 10000,
        'stock' => 10,
    ]);

    $payload = [
        'name' => 'Updated {{ model }}',
        'sku' => 'PRD-002',
        'description' => 'Updated description',
        'price' => 25000,
        'stock' => 50,
        'weight' => 2.50,
        'is_active' => true,
    ];

    Sanctum::actingAs($this->user);

    $response = $this->put(
        "{$this->endpoint}/{${{ variable }}->id}",
        $payload
    );

    $response
        ->assertSuccessful()
        ->assertJsonStructure([
            'data' => [
                'type',
                'id',
                'attributes',
            ],
        ]);

    $this->assertDatabaseHas('{{ table }}', [
        'id' => ${{ variable }}->id,
        'name' => 'Updated {{ model }}',
        'sku' => 'PRD-002',
        'price' => 25000,
        'stock' => 50,
    ]);
});
