<?php

declare(strict_types=1);

use App\Models\{{ model }};
use App\Models\User;
use Laravel\Sanctum\Sanctum;

beforeEach(function (): void {
    $this->user = User::factory()->create();
    $this->endpoint = '/api/{{ route_path }}/{{ table }}/export';
});

it('can export {{ table }} to csv', function (): void {
    {{ model }}::factory()->create([
        'name' => '{{ model }} A',
        'sku' => 'SKU-001',
        'description' => 'Description A',
        'price' => 10000,
        'stock' => 10,
        'weight' => 1.5,
        'is_active' => true,
    ]);

    {{ model }}::factory()->create([
        'name' => '{{ model }} B',
        'sku' => 'SKU-002',
        'description' => 'Description B',
        'price' => 20000,
        'stock' => 20,
        'weight' => 2.5,
        'is_active' => false,
    ]);

    Sanctum::actingAs($this->user);

    $response = $this->get($this->endpoint);

    $response
        ->assertSuccessful()
        ->assertHeader('content-type', 'text/csv; charset=UTF-8')
        ->assertHeader(
            'content-disposition',
            'attachment; filename={{ table }}.csv',
        );

    $content = $response->streamedContent();

    expect($content)
        ->toContain('id;name;sku;description;price;stock;weight;is_active')
        ->toContain('{{ model }} A')
        ->toContain('SKU-001')
        ->toContain('Description A')
        ->toContain('10000')
        ->toContain('10')
        ->toContain('1.5')
        ->toContain('1')
        ->toContain('{{ model }} B')
        ->toContain('SKU-002')
        ->toContain('Description B')
        ->toContain('20000')
        ->toContain('20')
        ->toContain('2.5')
        ->toContain('0');
});
