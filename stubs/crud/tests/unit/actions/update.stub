<?php

declare(strict_types=1);

use App\Actions\{{ model }}\Update{{ model }}Action;
use App\DTOs\{{ model }}\Update{{ model }}DTO;
use App\Models\{{ model }};

it('can update a {{ variable }}', function (): void {
    ${{ variable }} = {{ model }}::factory()->create([
        'name' => 'Old {{ model }}',
        'sku' => 'PRD-001',
        'price' => 10000,
        'stock' => 10,
    ]);

    $request = [
        'name' => 'Updated {{ model }}',
        'sku' => 'PRD-002',
        'description' => 'Updated description',
        'price' => 25000,
        'stock' => 50,
        'weight' => 2.50,
        'is_active' => true,
    ];

    $action = new Update{{ model }}Action();
    $data = new Update{{ model }}DTO($request);

    $result = $action->execute($data, (string) ${{ variable }}->id);

    $this->assertDatabaseHas('{{ table }}', [
        'id' => ${{ variable }}->id,
        'name' => 'Updated {{ model }}',
        'sku' => 'PRD-002',
        'price' => 25000,
        'stock' => 50,
    ]);
});
