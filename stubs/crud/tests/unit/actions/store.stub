<?php

declare(strict_types=1);

use App\Actions\{{ model }}\Store{{ model }}Action;
use App\DTOs\{{ model }}\Store{{ model }}DTO;

it('can store a {{ variable }}', function (): void {

    $request = [
        'name' => 'Store {{ model }}',
        'sku' => 'PRD-002',
        'description' => 'Store description',
        'price' => 25000,
        'stock' => 50,
        'weight' => 2.50,
        'is_active' => true,
    ];

    $action = new Store{{ model }}Action();

    $data = new Store{{ model }}DTO($request);

    $result = $action->execute($data);

    $this->assertDatabaseHas('{{ table }}', [
        'id' => $result['{{ variable }}']->id,
        'name' => 'Store {{ model }}',
        'sku' => 'PRD-002',
        'description' => 'Store description',
        'price' => 25000,
        'stock' => 50,
        'weight' => 2.50,
        'is_active' => true,
    ]);
});
