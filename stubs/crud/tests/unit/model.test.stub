<?php

declare(strict_types=1);

use App\Models\{{ model }};

test('to array', function (): void {
    ${{ variable }} = {{ model }}::factory()->create()->refresh();

    expect(array_keys(${{ variable }}->toArray()))
        ->toBe([
            'id',
            'name',
            'sku',
            'description',
            'price',
            'stock',
            'weight',
            'is_active',
            'created_at',
            'updated_at',
        ]);
});
