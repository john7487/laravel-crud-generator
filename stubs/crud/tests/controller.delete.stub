<?php

declare(strict_types=1);

use App\Models\{{ model }};

it('can delete a {{ variable }}', function (): void {
    ${{ variable }} = {{ model }}::factory()->create();

    $response = $this->delete(
        "/api/{{ route_path }}/{{ table }}/{${{ variable }}->id}"
    );

    $response->assertSuccessful();

    $this->assertDatabaseMissing('{{ table }}', [
        'id' => ${{ variable }}->id,
    ]);
});

it('returns not found when deleting a {{ variable }} that does not exist', function (): void {
    $response = $this->delete('/api/{{ route_path }}/{{ table }}/999999');

    $response->assertNotFound();
});
