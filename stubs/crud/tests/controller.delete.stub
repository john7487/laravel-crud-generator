<?php

declare(strict_types=1);

use App\Models\{{ model }};
use App\Models\User;
use Laravel\Sanctum\Sanctum;

beforeEach(function (): void {
    $this->user = User::factory()->create();
    $this->endpoint = '/api/{{ route_path }}/{{ table }}';
});

it('can delete a {{ variable }}', function (): void {
    ${{ variable }} = {{ model }}::factory()->create();

    Sanctum::actingAs($this->user);

    $response = $this->delete(
        "{$this->endpoint}/{${{ variable }}->id}"
    );

    $response->assertSuccessful();

});

it('returns not found when deleting a {{ variable }} that does not exist', function (): void {

    Sanctum::actingAs($this->user);

    $response = $this->delete('{$this->endpoint}/{{ table }}/999999');

    $response->assertNotFound();
});
