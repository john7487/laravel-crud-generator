<?php

declare(strict_types=1);

use App\Models\User;
use App\Models\{{ model }};
use Laravel\Sanctum\Sanctum;

beforeEach(function (): void {
    $this->user = User::factory()->create();
    $this->endpoint = '/api/{{ route_path }}/{{ table }}';
});

it('can store a {{ variable }}', function (): void {
    $payload = [
        'name' => 'Test {{ model }}',
        'sku' => 'PRD-001',
        'description' => '{{ model }} description',
        'price' => 150000.50,
        'stock' => 100,
        'weight' => 1.25,
        'is_active' => true,
    ];

    Sanctum::actingAs($this->user);

    $response = $this->post($this->endpoint, $payload);

    $response
        ->assertSuccessful()
        ->assertJsonStructure([
            'data' => [
                'type',
                'id',
                'attributes',
            ],
        ]);

    $this->assertDatabaseHas('{{ table }}', [
        'name' => 'Test {{ model }}',
        'sku' => 'PRD-001',
        'stock' => 100,
    ]);

    expect({{ model }}::query()->count())->toBe(1);
});
