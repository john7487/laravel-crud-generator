<?php

declare(strict_types=1);

namespace App\Http\Controllers\Api{{ controller_namespace }}\{{ model }};

use App\Actions\{{ model }}\{{ crud }}{{ model }}Action;
use App\Http\Requests\Api{{ controller_namespace }}\{{ model }}\{{ crud }}Request;
use App\Traits\ApiResponse;
use Illuminate\Http\JsonResponse;

final class {{ crud }}Controller
{
    use ApiResponse;

    public function __invoke({{ crud }}Request $request, {{ crud }}{{ model }}Action $action): JsonResponse
    {

        $result = $action->execute($request->toDto());

        return $this->noData(
