final class {{ crud }}Controller
{
    use ApiResponse;

    public function __invoke({{ crud }}Request $request, {{ crud }}{{ model }}Action $action, {{ model }} ${{ variable }}): JsonResponse
    {

        $result = $action->execute($request->toDto(), ${{ variable }});

