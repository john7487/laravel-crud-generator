<?php

declare(strict_types=1);

namespace App\Actions\{{ model }};

use App\Models\{{ model }};
use Symfony\Component\HttpFoundation\StreamedResponse;

final class {{ crud }}{{ model }}Action
{
    public function execute(): StreamedResponse
    {
        return response()->streamDownload(
            function (): void {
                $handle = fopen('php://output', 'w');

                assert($handle !== false);

                fputcsv(
                    $handle,
                    [
                        'id',
                        'name',
                        'sku',
                        'description',
                        'price',
                        'stock',
                        'weight',
                        'is_active',
                    ],
                    ';',
                    escape: '\\',
                );

                {{ model }}::query()
                    ->orderBy('id')
                    ->cursor()
                    ->each(function ({{ model }} ${{ variable }}) use ($handle): void {
                        fputcsv(
                            $handle,
                            [
                                ${{ variable }}->id,
                                ${{ variable }}->name,
                                ${{ variable }}->sku,
                                ${{ variable }}->description,
                                ${{ variable }}->price,
                                ${{ variable }}->stock,
                                ${{ variable }}->weight,
                                ${{ variable }}->is_active ? 1 : 0,
                            ],
                            ';',
                            escape: '\\',
                        );
                    });

                fclose($handle);
            },
            '{{ table }}.csv',
            [
                'Content-Type' => 'text/csv',
            ],
        );
    }
}
