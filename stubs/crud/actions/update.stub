<?php

declare(strict_types=1);

namespace App\Actions\{{ model }};

use App\DTOs\{{ model }}\{{ crud }}{{ model }}DTO;
use App\Models\{{ model }};

final readonly class {{ crud }}{{ model }}Action
{
    /**
     * @return array{{{ variable }}: {{ model }}}
     */
    public function execute({{ crud }}{{ model }}DTO $data, string ${{ variable }}): array
    {
        $model = {{ model }}::query()->findOrFail(${{ variable }});

        $model->update($data->attributes);

        return [
            '{{ variable }}' => $model,
        ];
    }
}
