<?php

declare(strict_types=1);

namespace App\Actions\{{ model }};

use App\Models\{{ model }};

final class {{ crud }}{{ model }}Action
{
    /**
     * @return array<string, {{ model }}>
     */
    public function execute(string ${{ variable }}): array
    {

        return [
            '{{ variable }}' => {{ model }}::query()->findOrFail(${{ variable }}),
        ];
    }
}
